{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ClinicManagement",
  "version": "1.0.0",
  "identifier": "com.clinic.management",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build:all",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "سامانه مدیریت مطب و کلینیک زیبایی",
        "width": 1360,
        "height": 860,
        "minWidth": 950,
        "minHeight": 650,
        "resizable": true,
        "fullscreen": false,
        "center": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "../dist-server/server.cjs": "backend/server.cjs",
      "../build/node-win/node.exe": "backend/node.exe",
      "../mongo-config.json": "mongo-config.json"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "windows": {
      "nsis": {
        "displayLanguageSelector": false
      }
    }
  }
}
